NODE_ENV=production
PORT=3333

# Supabase: projeto CRM R2 MARKETING DIGITAL.
# O startup bloqueia qualquer conexão com outro projeto ou com outro schema.
SUPABASE_PROJECT_REF=iqrnytsgwaiegddfxfjs
DATABASE_SCHEMA=gestao_ads

# EasyPanel: use o Session Pooler IPv4 do Supabase (porta 5432).
# Substitua <SENHA_DO_BANCO> e mantenha obrigatoriamente o schema gestao_ads.
# Caracteres especiais da senha precisam estar codificados para URL.
DATABASE_URL=postgresql://postgres.iqrnytsgwaiegddfxfjs:<SENHA_DO_BANCO>@aws-0-us-west-2.pooler.supabase.com:5432/postgres?sslmode=require&schema=gestao_ads
DIRECT_URL=postgresql://postgres.iqrnytsgwaiegddfxfjs:<SENHA_DO_BANCO>@aws-0-us-west-2.pooler.supabase.com:5432/postgres?sslmode=require&schema=gestao_ads
PRISMA_DB_PUSH=true

# Primeiro administrador.
# Ao configurar SEED_ADMIN_PASSWORD, o startup executa o seed mesmo com
# RUN_SEED_ON_START=false. Depois da criação, a senha existente é preservada.
RUN_SEED_ON_START=false
SEED_ADMIN_NAME=Administrador R2R
SEED_ADMIN_EMAIL=admin@r2rmarketingdigital.com.br
SEED_ADMIN_PASSWORD=
SEED_DEMO_CLIENT=false

# Use somente para uma redefinição administrativa intencional.
# Volte para false logo após o deploy que redefinir a senha.
FORCE_ADMIN_PASSWORD_RESET=false

# Gere chaves diferentes e fortes. Nunca reutilize secrets de outros projetos.
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d
# 64 caracteres hexadecimais: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

FRONTEND_URL=https://gestao.r2rmarketingdigital.com.br
API_PUBLIC_URL=https://api-gestao.r2rmarketingdigital.com.br
CORS_ORIGINS=https://gestao.r2rmarketingdigital.com.br

DEMO_MODE=false
# Sincronização server-side das contas Meta. O dashboard também atualiza a visualização a cada 5 minutos.
SYNC_INTERVAL_MINUTES=5
LOG_LEVEL=info

# Meta Developers. Nunca grave META_APP_SECRET no GitHub; configure somente no EasyPanel.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://api-gestao.r2rmarketingdigital.com.br/meta/oauth/callback
META_API_VERSION=v25.0

REDIS_URL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
WHATSAPP_SUPPORT=5547996753735
